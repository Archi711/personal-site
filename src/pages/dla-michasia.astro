---
import Head from "@/layouts/Head.astro";
import Layout from "@/layouts/Layout.astro";
import QRImg from "@/assets/qr.jpeg";
import { formatDuration, intervalToDuration } from "date-fns";
import { pl } from "date-fns/locale";
import { Image } from "astro:assets";

const dateTo = new Date(2026, 8, 7, 16, 0, 0);

const est = intervalToDuration({ end: dateTo, start: Date.now() });
const dur = formatDuration(est, { locale: pl });
const lines = dur.match(/\d+\s+\p{L}+/gu);
if (!lines) return;
const start = lines.join("<br/>");
---

<Layout>
  <Head
    slot={"head"}
    title="Prezent!!!"
    description="Nie interesuj się!"
    robots="noindex, nofollow"
  />
  <div
    class="min-h-screen text-center p-8 flex flex-col items-center justify-center gap-4">
    <p class="font-serif text-5xl">Wszystkiego najlepszego!!</p>
    <Image src={QRImg} alt="QREK" />
  </div>
</Layout>

<script>
  import { formatDuration, intervalToDuration } from "date-fns";
  import { pl } from "date-fns/locale";
  const target = document.querySelector<HTMLSpanElement>("[data-countdown]")!;
  const dateTo = new Date(2026, 8, 7, 16, 0, 0);
  setInterval(() => {
    const est = intervalToDuration({ end: dateTo, start: Date.now() });

    const dur = formatDuration(est, { locale: pl });
    const lines = dur.match(/\d+\s+\p{L}+/gu);
    if (!lines) return;
    const start = lines.join("<br/>");
    target.innerHTML = start;
  }, 1000);
</script>
